meta {
  name: Strategy: ML XGBoost
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/backtest
  body: json
  auth: none
}

body:json {
  {
    "strategy_name": "ml_strategy",
    "symbol": "SPY",
    "start_date": "2025-08-05T00:00:00",
    "end_date": "2025-11-06T23:59:59",
    "initial_capital": "10000",
    "commission_per_share": "0",
    "slippage_bps": 5,
    "config": {
      "model_path": "models/xgboost_spy_latest.pkl",
      "position_size": 10,
      "confidence_threshold": 0.65,
      "require_all_timeframes": true,
      "max_bars_buffer": 200
    }
  }
}

docs {
  Run a backtest for the ML Strategy (XGBoost classifier)
  
  Strategy Details:
  - Uses pre-trained XGBoost model with 140 multi-timeframe features
  - Predicts BUY/SELL/HOLD signals on 1-minute bars
  - Requires 1min, 5min, 15min, and 30min data
  - Filters signals by confidence threshold (default: 0.65)
  - Automatically closes positions at 3:55 PM ET
  
  Returns:
  - Backtest ID and status
  - Performance metrics (total return, Sharpe ratio, max drawdown, etc.)
  - All trades executed
  - Equity curve points
  
  Date range: Test period (Aug 2025 - Nov 2025)
  Initial capital: $10,000
  No commission, 5 bps slippage
  
  Note: Adjust confidence_threshold (0.5-0.9) to tune trade frequency
}
