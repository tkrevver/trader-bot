meta {
  name: Check for Gaps
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/market-data/:symbol/gaps?days_back=5
  body: none
  auth: none
}

params:query {
  days_back: 5
}

params:path {
  symbol: SPY
}

docs {
  Check for gaps in market data
  
  Query params:
  - days_back: Number of days to check (1-30, default: 5)
  
  Returns list of detected gaps with start/end times and missing bar counts
}
